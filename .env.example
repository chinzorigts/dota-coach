# Optional: you can paste the API key in Settings instead (it overrides this).
# Without any key only the rule engine runs.
ANTHROPIC_API_KEY=

# Must match the auth token in the GSI cfg (npm run install-cfg writes the same value)
GSI_TOKEN=dota-coach-local

# Server port / bind address. Use HOST=0.0.0.0 to view from a phone or another PC
PORT=3001
HOST=127.0.0.1

# Claude settings: initial defaults only. Change them later in Settings (/#settings)
COACH_MODEL=claude-opus-5-5
COACH_EFFORT=low
# Minimum seconds between automatic advice calls. Manual questions are not limited
COACH_AI_MIN_INTERVAL=90
# Set to off to disable AI calls even when a key is present
COACH_AI=on

# Dota 2 install path (when install-cfg can't find it automatically)
# DOTA_PATH=C:\Program Files (x86)\Steam\steamapps\common\dota 2 beta
