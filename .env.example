# Claude 조언을 켜려면 API 키를 넣으세요 (없으면 규칙 엔진만 동작)
ANTHROPIC_API_KEY=

# GSI cfg 의 auth token 과 같아야 합니다 (npm run install-cfg 가 같은 값을 씁니다)
GSI_TOKEN=dota-coach-local

# 서버 포트 / 바인딩. 폰·다른 PC 에서 보려면 HOST=0.0.0.0
PORT=3001
HOST=127.0.0.1

# Claude 설정
COACH_MODEL=claude-opus-5-5
COACH_EFFORT=low
# 자동 조언 최소 간격(초). 수동 질문은 이 제한을 받지 않습니다
COACH_AI_MIN_INTERVAL=90
# off 로 두면 키가 있어도 AI 호출 안 함
COACH_AI=on

# Dota 2 설치 경로 (install-cfg 가 자동으로 못 찾을 때)
# DOTA_PATH=C:\Program Files (x86)\Steam\steamapps\common\dota 2 beta
